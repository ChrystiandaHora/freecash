# =============================================================================
# FreeCash — Variáveis de Ambiente (.env)
# Copie para `.env` e preencha os valores antes de iniciar.
# =============================================================================

# --- Banco de Dados -----------------------------------------------------------
DB_NAME=freecash_db
DB_USER=freecash_user
DB_PASS=freecash_pass
DB_HOST=postgres
DB_PORT=5432

# --- Django -------------------------------------------------------------------
# Gere com: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-a-new-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_LOG_LEVEL=INFO

# --- Portas Locais (run.sh / Docker) ------------------------------------------
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Frontend -----------------------------------------------------------------
# Origem da API consumida pelo bundle do React
VITE_API_URL=http://localhost:8000
# URL base do SPA para links enviados por e-mail
FRONTEND_BASE_URL=http://localhost:5173

# --- E-mail (SMTP) ------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=FreeCash <nao-responda@seudominio.com.br>

# Opcionais (descomente para customizar):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_ASYNC=True

# --- Validade de Tokens e Prazos (segundos / dias) ----------------------------
# DJANGO_PASSWORD_RESET_TIMEOUT=10800
# DJANGO_EMAIL_VERIFICATION_TIMEOUT=259200
# DJANGO_EMAIL_VERIFICATION_GRACE_DAYS=7

# --- Segurança e CORS (Produção) ----------------------------------------------
# DJANGO_CORS_ALLOWED_ORIGINS=https://freecash.exemplo.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://freecash.exemplo.com
# DJANGO_AUTH_COOKIE_SECURE=True
# DJANGO_AUTH_COOKIE_SAMESITE=Lax
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True

# --- Produção (Gunicorn / Nginx) ----------------------------------------------
# HTTP_PORT=80
# GUNICORN_WORKERS=3
