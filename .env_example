# =============================================================================
# FreeCash — variáveis de ambiente
#
# Copie para `.env` e ajuste. O `.env` é ignorado pelo git e nunca deve ser
# versionado.
#
# Quando DJANGO_DEBUG=False, o backend valida esta configuração no boot e se recusa
# a iniciar se algo obrigatório faltar ou ainda estiver com o valor de exemplo. Isso
# é intencional: falhar de imediato é melhor que subir em produção com a chave de
# desenvolvimento assinando os tokens de sessão.
# =============================================================================

# --- Banco de dados (obrigatórias) -------------------------------------------
DB_NAME=freecash_db
DB_USER=freecash_user
DB_PASS=freecash_pass
# Em Docker, o host é o nome do serviço no compose. Fora dele, use localhost.
DB_HOST=postgres
DB_PORT=5432

# --- Django (obrigatórias) ----------------------------------------------------
# Gere uma chave nova para cada ambiente:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-a-new-secret-key

# Nunca True em produção.
DJANGO_DEBUG=True

# Domínios que o backend aceita atender. Em produção, liste os reais.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Nível dos logs da aplicação: DEBUG, INFO, WARNING, ERROR.
DJANGO_LOG_LEVEL=INFO

# --- Portas do orquestrador local (run.sh / run.py) --------------------------
# O run.sh detecta conflito de porta e regrava estes valores em .env.docker.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Frontend ----------------------------------------------------------------
# Origem da API usada pelo bundle do React. Atenção: o Vite embute as variáveis
# VITE_* em tempo de BUILD — alterá-la no ambiente do contêiner de produção não tem
# efeito, é preciso reconstruir a imagem.
# Em produção, aponte para a própria origem pública: o nginx faz o proxy de /api/
# para o backend, o que mantém API e SPA na mesma origem e dispensa CORS.
VITE_API_URL=http://localhost:8000

# URL base do SPA, usada para montar os links enviados por e-mail (verificação de
# conta e redefinição de senha). Precisa ser a URL que o usuário abre no navegador.
FRONTEND_BASE_URL=http://localhost:5173

# --- E-mail (obrigatórias em produção) ----------------------------------------
# SEM ISTO, O SISTEMA NÃO ENVIA E-MAIL — e a falha é silenciosa. Em produção o
# backend padrão é SMTP; com EMAIL_HOST vazio, cada envio falha e vai só para o log.
# Na prática: quem se cadastra nunca recebe o link de confirmação, e a recuperação
# de senha responde "enviamos as instruções" sem enviar nada (a resposta é genérica
# de propósito, para não revelar quais e-mails têm conta).
#
# Funciona com qualquer provedor que ofereça SMTP: Resend, Brevo, SendGrid, SES,
# Postmark, Mailtrap. Entregabilidade (SPF, DKIM, DMARC) se resolve no DNS do
# domínio, não aqui.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10

# Remetente. Use um endereço do SEU domínio, senão o provedor recusa o envio.
DEFAULT_FROM_EMAIL=FreeCash <nao-responda@seudominio.com.br>

# Backend de e-mail. O padrão já é console em desenvolvimento e SMTP em produção;
# só defina para forçar algo diferente (ex.: console em produção para depurar).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Envio em thread, fora do caminho da requisição. Desligue apenas em teste, onde o
# envio precisa ser síncrono para ser verificável.
# DJANGO_EMAIL_ASYNC=True

# --- Validade dos links enviados por e-mail -----------------------------------
# Redefinição de senha, em segundos. Padrão: 3 horas.
# DJANGO_PASSWORD_RESET_TIMEOUT=10800

# Confirmação de conta e troca de e-mail, em segundos. Padrão: 3 dias — confirmar a
# conta é menos urgente que recuperar o acesso a ela.
# DJANGO_EMAIL_VERIFICATION_TIMEOUT=259200

# Dias de carência antes de exigir e-mail confirmado para importar e exportar em
# massa. O CRUD financeiro nunca é bloqueado. Padrão: 7.
# DJANGO_EMAIL_VERIFICATION_GRACE_DAYS=7

# --- Segurança de transporte (produção) ---------------------------------------
# Origens permitidas para CORS. Vazio em desenvolvimento usa localhost automaticamente.
# DJANGO_CORS_ALLOWED_ORIGINS=https://freecash.exemplo.com

# Origens confiáveis para CSRF. Precisam incluir o esquema (https://).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://freecash.exemplo.com

# Marca o cookie do refresh token como Secure. O padrão é o inverso de DEBUG;
# só defina explicitamente se souber por quê.
# DJANGO_AUTH_COOKIE_SECURE=True

# Use None (com AUTH_COOKIE_SECURE=True) apenas se o frontend for servido de outro
# domínio que não o da API. Com o proxy do nginx, Lax é o correto.
# DJANGO_AUTH_COOKIE_SAMESITE=Lax

# Redirecionamento para HTTPS e HSTS. Ativos por padrão quando DEBUG=False.
# Desligue o HSTS apenas enquanto o domínio ainda não tem certificado válido.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True

# --- Produção (docker-compose.prod.yml) --------------------------------------
# Porta pública do nginx que serve o SPA e faz proxy da API.
# HTTP_PORT=80
# Número de processos do gunicorn. Regra de partida: 2 × núcleos + 1.
# GUNICORN_WORKERS=3

# --- Os três cenários de publicação ------------------------------------------
# As variáveis acima combinam de formas diferentes conforme a exposição do servidor.
# O passo a passo está em DEPLOY.md; aqui ficam só as diferenças.
#
# A) Só IP, sem HTTPS — para validar o primeiro deploy. NÃO use com dados reais:
#    sem TLS, a senha e o cookie do refresh trafegam em texto claro.
#      DJANGO_ALLOWED_HOSTS=203.0.113.10
#      VITE_API_URL=http://203.0.113.10
#      DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10
#      DJANGO_SECURE_SSL_REDIRECT=False
#      DJANGO_AUTH_COOKIE_SECURE=False
#      DJANGO_SECURE_HSTS_SECONDS=0
#
# B) Domínio com TLS no próprio servidor (Caddy ou Certbot):
#      DJANGO_ALLOWED_HOSTS=freecash.exemplo.com
#      VITE_API_URL=https://freecash.exemplo.com
#      DJANGO_CSRF_TRUSTED_ORIGINS=https://freecash.exemplo.com
#      DJANGO_SECURE_SSL_REDIRECT=True
#      DJANGO_AUTH_COOKIE_SECURE=True
#      DJANGO_SECURE_HSTS_SECONDS=31536000
#    Ative o HSTS só após confirmar o certificado: o navegador memoriza a exigência
#    de HTTPS por um ano.
#
# C) Domínio atrás do Cloudflare: valores iguais ao B. O que faz funcionar é o
#    SECURE_PROXY_SSL_HEADER lendo o X-Forwarded-Proto que o nginx repassa — sem
#    ele o Django enxerga HTTP e o SSL_REDIRECT entra em laço.
#
# Em todos, VITE_API_URL é embutida no bundle em tempo de build: mudá-la exige
# `docker compose -f docker-compose.prod.yml up -d --build frontend`.
