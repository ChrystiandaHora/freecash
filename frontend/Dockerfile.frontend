# Stage 1: Development
FROM node:20-alpine AS development
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host"]

# Stage 2: Builder
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# O Vite embute as variáveis VITE_* no bundle em tempo de build, e não em tempo de
# execução: definir VITE_API_URL no ambiente do contêiner de produção não teria
# efeito algum. Por isso ela precisa entrar como argumento de build.
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Stage 3: Production
FROM nginx:stable-alpine AS production
COPY --from=builder /app/dist /usr/share/nginx/html
# Substitui a configuração padrão: sem o fallback do SPA, qualquer rota interna
# acessada diretamente (inclusive os links enviados por e-mail) devolveria 404.
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
