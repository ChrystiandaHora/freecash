# O eslint-plugin-jsx-a11y 6.10.2 (última versão publicada) declara peer eslint <=9,
# mas funciona com o eslint 10 — sem isso o npm install falha com ERESOLVE.
legacy-peer-deps=true

# Nenhum dos 382 pacotes do lock tem preinstall, install ou postinstall: desligar não
# muda um byte da instalação e fecha o vetor por padrão. `npm run` segue intacto — o
# flag só bloqueia lifecycle e pre/post.
ignore-scripts=true
