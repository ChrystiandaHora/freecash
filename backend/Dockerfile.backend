# Stage 1: Build dependencies
FROM python:3.14-slim AS builder

WORKDIR /app

# Instalar dependências de compilação
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Criar pacotes wheel (pré-compilados) para não precisar do gcc no runtime
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels -r requirements.txt

# Stage 2: Runtime Image
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Instalar as bibliotecas mínimas do postgres
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copiar os bibliotecas wheel pré-compiladas
COPY --from=builder /app/wheels /wheels
COPY --from=builder /app/requirements.txt .

# Instalar a partir dos pacotes wheel sem cache de pip
RUN pip install --no-cache /wheels/* \
    && rm -rf /wheels \
    && rm requirements.txt

COPY . .

# DJANGO_DEBUG=True vale só para esta camada: collectstatic não toca o banco, e sem
# isto a validação de boot do settings.py abortaria a construção da imagem.
RUN DJANGO_DEBUG=True python manage.py collectstatic --noinput

# O entrypoint prepara o banco e entrega o controle ao processo web (runserver em
# desenvolvimento, gunicorn abaixo). O chmod cobre checkout feito no Windows.
RUN chmod +x /app/entrypoint.sh
ENTRYPOINT ["/app/entrypoint.sh"]

# Servidor de produção: `runserver` é single-threaded e sem endurecimento, e nunca
# deve atender tráfego público. O compose de desenvolvimento sobrescreve este CMD.
CMD ["gunicorn", "freecash.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--timeout", "60", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
