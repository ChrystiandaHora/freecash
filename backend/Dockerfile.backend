# Stage 1: Build dependencies
FROM python:3.14-slim AS builder

WORKDIR /app

# Instalar dependências de compilação
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Criar pacotes wheel (pré-compilados) para não precisar do gcc no runtime
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /app/wheels -r requirements.txt

# Stage 2: Runtime Image
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Instalar as bibliotecas mínimas do postgres
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copiar os bibliotecas wheel pré-compiladas
COPY --from=builder /app/wheels /wheels
COPY --from=builder /app/requirements.txt .

# Instalar a partir dos pacotes wheel sem cache de pip
RUN pip install --no-cache /wheels/* \
    && rm -rf /wheels \
    && rm requirements.txt

COPY . .

# DJANGO_DEBUG=True vale apenas para esta camada de build: collectstatic não toca
# o banco nem precisa de configuração de produção, e sem isto a validação de boot
# de settings.py (que exige SECRET_KEY e DB_* reais quando DEBUG=False) abortaria a
# construção da imagem. A variável não persiste para o runtime.
RUN DJANGO_DEBUG=True python manage.py collectstatic --noinput

# O entrypoint aplica migrations e cria a tabela de cache do throttle antes de
# entregar o controle ao processo web, seja ele o runserver do compose de
# desenvolvimento ou o gunicorn do CMD abaixo. O chmod é defensivo: um checkout
# feito no Windows pode perder o bit de execução.
RUN chmod +x /app/entrypoint.sh
ENTRYPOINT ["/app/entrypoint.sh"]

# Servidor de aplicação de produção. `runserver` é um servidor de desenvolvimento:
# single-threaded, com auto-reload e sem endurecimento — nunca deve atender tráfego
# público. O gunicorn já constava em requirements.txt sem nunca ser usado.
# O compose de desenvolvimento sobrescreve este CMD para manter o auto-reload.
CMD ["gunicorn", "freecash.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--timeout", "60", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
